{
  "name": "vprs-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --app",
    "preview": "vite preview --outDir dist/static",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs",
    "edge": "npm run build:vercel && node edge-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^0.0.0-experimental-7dfc7ccd-20260803",
    "react-dom": "^0.0.0-experimental-7dfc7ccd-20260803",
    "react-server-loader": "^0.0.0-experimental-7dfc7ccd-20260803"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.9",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.7.3",
    "vite": "^8.1.4",
    "vite-plugin-react-server": "^3.9.0"
  },
  "description": "Minimal vite-plugin-react-server starter: file-based routes, one-call client entry, and per-request server rendering on Vercel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobrinkkemper/vprs-starter.git"
  }
}
