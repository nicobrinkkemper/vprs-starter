{
  "name": "vprs-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rsc": "NODE_OPTIONS='--conditions=react-server' vite",
    "build": "vite build --app && node scripts/emit-client-entry.mjs",
    "preview": "vite preview --outDir dist/static",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs",
    "edge": "npm run build && node edge-server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite-plugin-react-server": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.9",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vite": "^8.1.4"
  }
}
